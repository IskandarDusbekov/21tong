# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Tashkent

# --- PostgreSQL ---
# Lokal ishlab chiqishda bo'sh qoldiring — SQLite ishlatiladi.
# PostgreSQL o'rnatilib, ishga tushgandan keyingina to'ldiring.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Bot <-> backend umumiy maxfiy kalit (uzun tasodifiy satr)
BOT_API_SECRET=change-me-too
BACKEND_URL=http://localhost:8000
# Arizalarni tasdiqlaydigan adminlar Telegram ID'lari, vergul bilan (ID'ni @userinfobot dan bilasiz)
ADMIN_IDS=
# Mini App HTTPS manzili (BotFather'da ham ro'yxatdan o'tkaziladi)
MINI_APP_URL=
# Manifest uchun TTF shrift (ixtiyoriy)
MANIFEST_FONT_PATH=

# --- Mini App (Vite) ---
VITE_API_URL=
