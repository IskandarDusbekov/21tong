# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring

# --- Django ---
DJANGO_SECRET_KEY=change-me
# Production'da: false
DJANGO_DEBUG=true
# Production'da domeningizni qo'shing: 127.0.0.1,localhost,21tong.uz,www.21tong.uz
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Production'da (HTTPS): https://21tong.uz,https://www.21tong.uz
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Tashkent

# --- PostgreSQL ---
# Lokal ishlab chiqishda bo'sh qoldiring — SQLite ishlatiladi.
# PostgreSQL o'rnatilib, ishga tushgandan keyingina to'ldiring.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Telegram ---
# BotFather'dan olingan token. Bu yerga HAQIQIY token yozmang — u faqat .env da bo'lsin.
TELEGRAM_BOT_TOKEN=123456789:AA-BotFatherdan-olingan-token
TELEGRAM_BOT_USERNAME=YigirmaBirTongBot
# Bot <-> backend umumiy maxfiy kalit (uzun tasodifiy satr)
BOT_API_SECRET=change-me-too
BACKEND_URL=http://localhost:8000
# Arizalarni tasdiqlaydigan adminlar Telegram ID'lari, vergul bilan (ID'ni @userinfobot dan bilasiz)
ADMIN_IDS=
# Mini App HTTPS manzili (production'da: https://21tong.uz). O'rnatilsa bot «Menu» tugmasini
# avtomatik Mini App'ga bog'laydi — BotFather'da qo'lda sozlash shart emas.
MINI_APP_URL=
# Rasmlar uchun TTF shriftlar papkasi (ixtiyoriy)
MANIFEST_FONT_DIR=

# --- Mini App (Vite) ---
VITE_API_URL=
