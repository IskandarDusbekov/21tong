{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "miniapp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "miniapp", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "8002"],
      "env": { "DJANGO_CSRF_TRUSTED_ORIGINS": "http://localhost:5174,http://localhost:5173" },
      "port": 8002,
      "autoPort": false
    },
    {
      "name": "panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "panel", "run", "dev"],
      "env": { "API_URL": "http://localhost:8002" },
      "port": 5174
    }
  ]
}
