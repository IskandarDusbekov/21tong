{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "miniapp",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "miniapp",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "panel",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
